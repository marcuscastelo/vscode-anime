{
  "name": "marucs-anime",
  "version": "0.5.1",
  "publisher": "Marucs",
  "displayName": "Marucs' Anime",
  "description": "Anime watch-history language support and editing tools for VS Code",
  "license": "MIT",
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "anime",
    "anl",
    "history",
    "syntax",
    "autocomplete"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcuscastelo/vscode-anime"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [
    "onLanguage:anime-list"
  ],
  "contributes": {
    "commands": [
      {
        "command": "marucs-anime.insertDate",
        "title": "Insert Current Date",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.insertTime",
        "title": "Insert Current Time",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.insertNextEpisode",
        "title": "Insert Next Episode",
        "category": "Marucs' Anime"
      }
    ],
    "keybindings": [
      {
        "command": "marucs-anime.insertDate",
        "key": "alt+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == anime-list"
      },
      {
        "command": "marucs-anime.insertTime",
        "key": "alt+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus && editorLangId == anime-list"
      },
      {
        "command": "marucs-anime.insertNextEpisode",
        "key": "alt+n",
        "mac": "cmd+shift+n",
        "when": "editorTextFocus && editorLangId == anime-list"
      }
    ],
    "languages": [
      {
        "id": "anime-list",
        "extensions": [
          ".anl"
        ],
        "aliases": [
          "Anime List",
          "ANL"
        ]
      }
    ],
    "grammars": [
      {
        "language": "anime-list",
        "scopeName": "source.anl",
        "path": "./syntaxes/anime-list.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "prebuild": "pnpm --filter @marucs-anime/core run build",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "clean": "rimraf dist coverage",
    "prepackage": "node scripts/prepare-package.mjs",
    "package": "pnpm run build && vsce package --no-dependencies --out ../../artifacts/marucs-anime.vsix",
    "package:verify": "node scripts/verify-vsix.mjs ../../artifacts/marucs-anime.vsix",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration:build": "node esbuild.integration.config.mjs",
    "test:integration": "pnpm run build && pnpm run test:integration:build && node scripts/run-integration.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@marucs-anime/core": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.102.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
