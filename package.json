{
  "name": "marucs-anime-monorepo",
  "version": "0.4.0",
  "private": true,
  "publisher": "Marucs",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "displayName": "Marucs' Anime",
  "description": "Anime Syntax and Utils for VSCode",
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "anime",
    "syntax",
    "linter",
    "utils",
    "history",
    "autocomplete",
    "intellisense",
    "highlight"
  ],
  "repository": {
    "url": "https://github.com/marcuscastelo/vscode-anime"
  },
  "capabilities": {
    "codeLensProvider": {
      "resolveProvider": true
    },
    "completionProvider": {
      "resolveProvider": "false",
      "triggerCharacters": [
        "{",
        "[",
        ","
      ]
    },
    "definitionProvider": "true"
  },
  "preview": true,
  "main": "./out/vscode-extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marucs-anime.insertDate",
        "title": "Insert Date",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.insertTime",
        "title": "Insert Time",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.insertNextEpisode",
        "title": "Insert Next Episode",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.formatFriend",
        "title": "Format Friend",
        "category": "Marucs' Anime"
      },
      {
        "command": "marucs-anime.clearCache",
        "title": "Clear cache",
        "category": "Marucs' Anime"
      }
    ],
    "keybindings": [
      {
        "command": "marucs-anime.insertDate",
        "key": "alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "marucs-anime.insertTime",
        "key": "alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "marucs-anime.insertNextEpisode",
        "key": "alt+n",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "anime-list",
        "extensions": [
          ".anl"
        ],
        "aliases": [
          "Anime list"
        ]
      }
    ],
    "grammars": [
      {
        "language": "anime-list",
        "scopeName": "source.anl",
        "path": "./syntaxes/anime-list.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:anime-list"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "vscode:prepublish": "pnpm run compile",
    "compile": "rm -rf ./out && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "tsc -w",
    "build": "tsc && pnpm bundle",
    "build:workspaces": "pnpm --recursive --if-present run build",
    "bundle": "esbuild src/vscode-extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workspaces": "pnpm --recursive --if-present run test",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:vscode": "node ./out/test/runTest.js",
    "pretest:vscode": "pnpm run compile && pnpm run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint . --max-warnings=0",
    "fix": "biome check --write . && eslint . --fix",
    "type-check": "tsc --noEmit",
    "type-check:workspaces": "pnpm --recursive --if-present run type-check",
    "commitlint": "commitlint --edit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test:run && pnpm run build",
    "copilot:check": "pnpm run check 2>&1 && echo 'COPILOT: All checks passed!' || echo 'COPILOT: Some checks failed!'",
    "clean": "rimraf out *.vsix",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.102.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "axios-rate-limit": "^1.9.0",
    "crypto-js": "^4.2.0",
    "rustic": "^1.2.2"
  }
}
