{
	"name": "marucs-anime",
	"version": "0.4.0",
	"publisher": "Marucs",
	"engines": {
		"vscode": "^1.95.0"
	},
	"license": "MIT",
	"displayName": "Marucs' Anime",
	"description": "Anime Syntax and Utils for VSCode",
	"categories": [
		"Linters",
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"anime",
		"syntax",
		"linter",
		"utils",
		"history",
		"autocomplete",
		"intellisense",
		"highlight"
	],
	"repository": {
		"url": "https://github.com/marcuscastelo/vscode-anime"
	},
	"capabilities": {
		"codeLensProvider": {
			"resolveProvider": true
		},
		"completionProvider": {
			"resolveProvider": "false",
			"triggerCharacters": [
				"{",
				"[",
				","
			]
		},
		"definitionProvider": "true"
	},
	"preview": true,
	"main": "./out/vscode-extension.js",
	"contributes": {
		"commands": [
			{
				"command": "marucs-anime.insertDate",
				"title": "Insert Date",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.insertTime",
				"title": "Insert Time",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.insertNextEpisode",
				"title": "Insert Next Episode",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.formatFriend",
				"title": "Format Friend",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.clearCache",
				"title": "Clear cache",
				"category": "Marucs' Anime"
			}
		],
		"keybindings": [
			{
				"command": "marucs-anime.insertDate",
				"key": "alt+d",
				"when": "editorTextFocus"
			},
			{
				"command": "marucs-anime.insertTime",
				"key": "alt+t",
				"when": "editorTextFocus"
			},
			{
				"command": "marucs-anime.insertNextEpisode",
				"key": "alt+n",
				"when": "editorTextFocus"
			}
		],
		"languages": [
			{
				"id": "anime-list",
				"extensions": [
					".anl"
				],
				"aliases": [
					"Anime list"
				]
			}
		],
		"grammars": [
			{
				"language": "anime-list",
				"scopeName": "source.anl",
				"path": "./syntaxes/anime-list.tmLanguage.json"
			}
		]
	},
	"activationEvents": [
		"onLanguage:anime-list"
	],
	"scripts": {
		"vscode:prepublish": "pnpm run compile",
		"compile": "rm -rf ./out && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"dev": "tsc -w",
		"build": "tsc && pnpm bundle",
		"bundle": "esbuild src/vscode-extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest --coverage",
		"test:ui": "vitest --ui",
		"test:vscode": "node ./out/test/runTest.js",
		"pretest:vscode": "pnpm run compile && pnpm run lint",
		"lint": "eslint src",
		"type-check": "tsc --noEmit",
		"clean": "rimraf out *.vsix",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@types/glob": "^7.2.0",
		"@types/node": "^22.17.0",
		"@types/vscode": "^1.102.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.25.8",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"glob": "^7.2.3",
		"globals": "^15.9.0",
		"prettier": "^3.3.3",
		"rimraf": "^6.0.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.0.0",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"axios": "^1.11.0",
		"axios-rate-limit": "^1.4.0",
		"crypto-js": "^4.2.0",
		"rustic": "^1.2.2"
	}
}
