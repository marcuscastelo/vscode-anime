{
	"name": "marucs-anime",
	"version": "0.4.0",
	"publisher": "Marucs",
	"engines": {
		"vscode": "^1.65.0"
	},
	"license": "MIT",
	"displayName": "Marucs' Anime",
	"description": "Anime Syntax and Utils for VSCode",
	"categories": [
		"Linters",
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"anime",
		"syntax",
		"linter",
		"utils",
		"history",
		"autocomplete",
		"intellisense",
		"highlight"
	],
	"repository": {
		"url": "https://github.com/marcuscastelo/vscode-anime"
	},
	"capabilities": {
		"codeLensProvider": {
			"resolveProvider": true
		},
		"completionProvider": {
			"resolveProvider": "false",
			"triggerCharacters": [
				"{",
				"[",
				","
			]
		},
		"definitionProvider": "true"
	},
	"preview": true,
	"main": "./out/vscode-extension.js",
	"contributes": {
		"commands": [
			{
				"command": "marucs-anime.insertDate",
				"title": "Insert Date",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.insertTime",
				"title": "Insert Time",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.insertNextEpisode",
				"title": "Insert Next Episode",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.formatFriend",
				"title": "Format Friend",
				"category": "Marucs' Anime"
			},
			{
				"command": "marucs-anime.clearCache",
				"title": "Clear cache",
				"category": "Marucs' Anime"
			}
		],
		"keybindings": [
			{
				"command": "marucs-anime.insertDate",
				"key": "alt+d",
				"when": "editorTextFocus"
			},
			{
				"command": "marucs-anime.insertTime",
				"key": "alt+t",
				"when": "editorTextFocus"
			},
			{
				"command": "marucs-anime.insertNextEpisode",
				"key": "alt+n",
				"when": "editorTextFocus"
			}
		],
		"languages": [
			{
				"id": "anime-list",
				"extensions": [
					".anl"
				],
				"aliases": [
					"Anime list"
				]
			}
		],
		"grammars": [
			{
				"language": "anime-list",
				"scopeName": "source.anl",
				"path": "./syntaxes/anime-list.tmLanguage.json"
			}
		]
	},
	"activationEvents": [
		"onLanguage:anime-list"
	],
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "rm -rf ./out && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "yarn run compile && yarn run lint",
		"lint": "npx eslint@9.8.0 src",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.8.0",
		"@types/glob": "^7.2.0",
		"@types/mocha": "^8.2.3",
		"@types/node": "^18.19.43",
		"@types/vscode": "^1.65.0",
		"@typescript-eslint/eslint-plugin": "^4.33.0",
		"@typescript-eslint/parser": "^4.33.0",
		"eslint": "^9.8.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"glob": "^7.2.3",
		"globals": "^15.9.0",
		"mocha": "^8.4.0",
		"prettier": "^3.3.3",
		"typescript": "^4.9.5",
		"typescript-eslint": "^8.0.0",
		"vscode-test": "^1.6.1"
	},
	"dependencies": {
		"axios": "^0.21.4",
		"axios-rate-limit": "^1.4.0",
		"crypto-js": "^4.2.0",
		"rustic": "^1.2.2"
	}
}
