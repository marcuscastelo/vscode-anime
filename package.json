{
  "name": "marucs-anime-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build:core": "pnpm --filter @marucs-anime/core run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "pnpm run build:core && pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint . --max-warnings=0",
    "fix": "biome check --write . && eslint . --fix",
    "type-check": "pnpm run build:core && pnpm --recursive --if-present run type-check",
    "test": "pnpm run build:core && pnpm --recursive --if-present run test",
    "test:coverage": "pnpm run build:core && pnpm --recursive --if-present run test:coverage",
    "test:integration": "pnpm --filter marucs-anime run test:integration",
    "build": "pnpm --recursive --if-present run build",
    "package": "pnpm --filter marucs-anime run package",
    "package:verify": "pnpm --filter marucs-anime run package:verify",
    "audit:production": "pnpm audit --prod --audit-level high",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build",
    "clean": "pnpm --recursive --if-present run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "typescript-eslint": "^8.63.0"
  }
}
